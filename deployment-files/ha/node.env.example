# Copy to node.env on each clean Linux host and chmod 0600.
# The three supported identities are fixed: ha-a and ha-b are database hosts;
# ha-c is the DCS witness. Replace only the IPs and local paths.
HA_NODE_NAME=ha-a
HA_NODE_IP=10.40.0.11

HA_DB_A_IP=10.40.0.11
HA_DB_B_IP=10.40.0.12
HA_DCS_C_IP=10.40.0.13

# Unused address on the same L2 network as ha-a and ha-b.
HA_VIRTUAL_IP=10.40.0.100
HA_NETWORK_INTERFACE=eth0

HA_DATA_DIR=/var/lib/proto-fleet/ha
HA_SECRETS_DIR=/etc/proto-fleet/ha
