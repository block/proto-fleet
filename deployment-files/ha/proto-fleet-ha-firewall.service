[Unit]
Description=Proto Fleet HA firewall
BindsTo=nftables.service
After=nftables.service
PartOf=nftables.service
Before=docker.service proto-fleet-ha.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /etc/proto-fleet/ha/firewall.nft
ExecStartPre=-/usr/sbin/nft delete table inet proto_fleet_ha
ExecStart=/usr/sbin/nft -f /etc/proto-fleet/ha/firewall.nft

[Install]
WantedBy=multi-user.target
